<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hostel Complaint Management System</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif}
  body{background:#0a1f44;overflow:hidden}
  .deck{width:100vw;height:100vh;position:relative}
  .slide{position:absolute;inset:0;display:none;padding:0;overflow:hidden;background:linear-gradient(135deg,#7cb8f0,#2a6bc4 60%,#0a2a6b)}
  .slide.active{display:flex;flex-direction:column}
  .topbar{background:#0a2a6b;color:#fff;padding:14px 28px;display:flex;justify-content:space-between;align-items:center}
  .topbar h3{font-size:20px;letter-spacing:.5px}
  .badge{background:#2a6bc4;padding:6px 14px;border-radius:20px;font-weight:700;font-size:13px}
  .content{flex:1;padding:28px 36px;overflow:auto}
  .center{text-align:center}
  h1{font-size:52px;line-height:1.15;color:#fff;text-shadow:0 4px 20px rgba(0,0,0,.3)}
  h2{font-size:38px;color:#0a2a6b;text-align:center}
  .subtitle{font-size:18px;color:#1a3a6b;margin-top:10px;text-align:center}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:26px}
  .card{background:#eef5ff;border-radius:16px;padding:22px;box-shadow:0 8px 20px rgba(0,0,0,.12);text-align:left}
  .card h3{color:#0a1f44;font-size:20px;margin:12px 0 10px}
  .card ul{padding-left:18px;color:#222;line-height:1.6;font-size:15px}
  .icon{width:68px;height:68px;border-radius:50%;background:#2a6bc4;color:#fff;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto}
  .impact{margin-top:20px;background:#0a4aa8;color:#fff;padding:16px 20px;border-radius:12px;font-size:16px;line-height:1.5}
  .goal{margin-top:18px;background:#0a2a6b;color:#fff;padding:12px 18px;border-radius:12px;text-align:center}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:22px}
  .panel{background:#fff;border-radius:16px;padding:22px}
  .panel h3{color:#0a2a6b;font-size:22px;margin-bottom:10px}
  .panel ul{padding-left:18px;line-height:1.7}
  input,select,textarea{width:100%;padding:10px 12px;border:1.5px solid #b8d0f0;border-radius:8px;margin:6px 0 12px;font-size:14px;background:#f2f7ff}
  label{font-weight:700;font-size:14px}
  .chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
  .chip{background:#dbeaff;border:1px solid #7cb8f0;padding:5px 10px;border-radius:20px;font-size:13px}
  .btn{padding:11px 18px;border-radius:10px;border:0;font-weight:700;cursor:pointer;font-size:15px}
  .btn-primary{background:#0a5ed6;color:#fff}
  .btn-light{background:#dbeaff;color:#0a2a6b}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .stat{background:#cfe2ff;border-radius:14px;padding:18px;text-align:center}
  .stat b{font-size:46px;color:#0a2a6b}
  table{width:100%;border-collapse:collapse;margin-top:14px;background:#fff;border-radius:12px;overflow:hidden}
  th{background:#0a4aa8;color:#fff;padding:12px;text-align:left}
  td{padding:11px 12px;border-bottom:1px solid #eee}
  .pill{padding:5px 10px;border-radius:20px;font-size:13px;font-weight:700}
  .pending{background:#ffe2b0;color:#8a4b00}
  .solved{background:#c9f2d0;color:#0a6b22}
  .nav{position:fixed;bottom:16px;left:0;right:0;display:flex;justify-content:center;align-items:center;gap:14px;z-index:10}
  .nav button{background:#fff;color:#0a2a6b;border:0;padding:10px 18px;border-radius:30px;font-weight:800;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.25)}
  .nav span{color:#fff;font-weight:700;background:rgba(0,0,0,.35);padding:8px 14px;border-radius:20px}
  .dots{display:flex;gap:6px;justify-content:center;margin-top:14px}
  .dot{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer}
  .dot.on{background:#fff}
  .thank{background:#9fc4f0;text-align:center;padding:18px}
  @media(max-width:800px){.cards,.two,.stats{grid-template-columns:1fr} h1{font-size:34px} h2{font-size:28px} .content{padding:18px}}
</style>
</head>
<body>
<div class="deck">

  <!-- SLIDE 1 -->
  <section class="slide active" style="justify-content:center;align-items:center;text-align:center;background:radial-gradient(circle at 30% 20%,#1a4a9a,#041a3d 70%)">
    <p style="color:#6aa8ff;letter-spacing:2px">Welcome</p>
    <h1 style="margin:18px 0">Hostel Complaint<br>Management System</h1>
    <h2 style="color:#6aa8ff;margin-top:14px">Mini Project Presentation</h2>
    <p style="color:#fff;margin-top:60px;font-weight:700">Adarsh Institute and Research Center Vita</p>
  </section>

  <!-- SLIDE 2 PROBLEM -->
  <section class="slide">
    <div class="topbar"><h3>🏫 HOSTEL COMPLAINT MANAGEMENT SYSTEM</h3><span class="badge">Slide 2</span></div>
    <div class="content">
      <h2>PROBLEM STATEMENT</h2>
      <p class="subtitle">Current Challenges in the Manual Complaint Process</p>
      <div class="cards">
        <div class="card"><div class="icon">📋</div><h3>Manual Complaint Issues</h3><ul><li>Paper-based forms prone to loss and errors</li><li>Inconsistent information from students</li><li>Time-consuming manual recording and filing</li></ul></div>
        <div class="card"><div class="icon">⏰</div><h3>Delays in Resolution</h3><ul><li>Slow response due to manual handling</li><li>No prioritization of urgent complaints</li><li>Escalation process is unclear and delayed</li></ul></div>
        <div class="card"><div class="icon">🔍</div><h3>No Tracking and Visibility</h3><ul><li>Students cannot track complaint status</li><li>Lack of transparency in resolution progress</li><li>No record or history for reference</li></ul></div>
      </div>
      <div class="impact"><b>⚠ IMPACT:</b> Decreased student satisfaction • Operational inefficiencies for hostel staff • Persistent unresolved issues affecting hostel environment</div>
      <p style="text-align:center;color:#fff;margin-top:12px">Current system relies entirely on manual processes → leading to inefficiencies and lack of accountability</p>
    </div>
  </section>

  <!-- SLIDE 3 OBJECTIVES -->
  <section class="slide">
    <div class="topbar"><h3>Hostel Complaint Management System</h3><span class="badge">Slide 3 - Objectives</span></div>
    <div class="content">
      <h2>Objectives</h2>
      <p class="subtitle">Building an efficient, transparent, and responsive complaint management system for hostels</p>
      <div class="cards">
        <div class="card"><div class="icon">⚙️</div><h3>Digitalize Process</h3><ul><li>Replace paper-based complaints with digital submissions</li><li>Streamline complaint intake and routing workflow</li><li>Reduce manual paperwork and processing delays</li></ul></div>
        <div class="card"><div class="icon">🕒</div><h3>Real-Time Tracking</h3><ul><li>Live status updates on complaint resolution progress</li><li>Monitor response times and escalation alerts</li><li>Track complaints from submission to closure</li></ul></div>
        <div class="card"><div class="icon">👁️</div><h3>Transparency</h3><ul><li>Clear visibility for students, staff, and management</li><li>Accessible logs and audit trail of all actions</li><li>Build trust through open communication and updates</li></ul></div>
      </div>
      <div class="goal">✅ Goal: Faster resolution • Improved accountability • Enhanced student satisfaction</div>
    </div>
  </section>

  <!-- SLIDE 4 LOGIN -->
  <section class="slide">
    <div class="topbar"><h3>HOSTEL COMPLAINT SYSTEM</h3><span class="badge">Slide 4</span></div>
    <div class="content">
      <h2 style="text-align:left">Login Page and User Roles</h2>
      <p class="subtitle" style="text-align:left">Secure Authentication for Student and Warden Access</p>
      <div class="two">
        <div class="panel" style="background:#0a5ed6;color:#fff">
          <h3 style="color:#fff">🔑 Login Page</h3>
          <div style="background:#fff;color:#222;border-radius:12px;padding:16px">
            <div style="display:flex;gap:8px;margin-bottom:12px"><button class="btn btn-light" onclick="switchRole('Student')">🎓 Student Login</button><button class="btn" onclick="switchRole('Warden')">🛡 Warden Login</button></div>
            <label>Email / Student ID</label><input id="loginEmail" placeholder="enter@student.college.edu">
            <label>Password</label><input type="password" value="password123">
            <p style="font-size:13px">☑ Remember me &nbsp; &nbsp; <span style="float:right;color:#0a5ed6">Forgot Password?</span></p>
            <button class="btn btn-primary" style="width:100%;margin-top:10px" onclick="alert('Login Demo: Welcome '+document.getElementById('loginEmail').value)">🔒 Sign In Securely</button>
            <p style="font-size:12px;text-align:center;margin-top:8px">Protected by end-to-end encryption • 2FA available</p>
          </div>
          <p style="font-size:13px;margin-top:12px"><b>Secure Authentication Features:</b><br>Password hashing and encryption<br>OTP / 2FA verification via email / SMS<br>Session timeout and CAPTCHA protection</p>
        </div>
        <div>
          <div class="panel"><h3>🎓 Student</h3><ul><li>Submit and track hostel complaints</li><li>View complaint status and history</li><li>Receive updates and notifications</li></ul></div>
          <div class="panel" style="margin-top:14px"><h3>👨‍💼 Warden</h3><ul><li>Review and manage all complaints</li><li>Assign staff and update resolution status</li><li>Manage hostel and user access controls</li></ul></div>
        </div>
      </div>
      <p style="text-align:center;margin-top:14px;color:#fff">🔒 Role-Based Access Control &nbsp; ✅ Secure and Compliant &nbsp; ☁ Data Privacy and Audit Logging</p>
    </div>
  </section>

  <!-- SLIDE 5 ARCHITECTURE -->
  <section class="slide" style="background:#fff">
    <div class="content">
      <h2>System Architecture and Workflow</h2>
      <p class="subtitle">Hostel Complaint System - From Submission to Resolution</p>
      <div class="two">
        <div><h3>🖥 SYSTEM ARCHITECTURE</h3>
          <div class="panel" style="background:#dbeaff;text-align:center">📱 <b>STUDENT MOBILE / WEB APP</b><br>Complaint Submission and Status Tracking</div><p style="text-align:center">↓</p>
          <div class="panel" style="background:#eef5ff;text-align:center"><b>API GATEWAY</b><br>Authentication • Request Routing • Validation</div><p style="text-align:center">↓</p>
          <div class="panel" style="background:#eef5ff;text-align:center"><b>BACKEND SERVICE</b><br>Business Logic • Role-Based Access Control • Notification Service</div><p style="text-align:center">↓</p>
          <div class="panel" style="background:#eef5ff;text-align:center">🗄 <b>DATABASE</b><br>Complaint Records • User Roles • Resolution Logs</div>
        </div>
        <div><h3>🔄 WORKFLOW PROCESS</h3>
          <div class="panel"><b>1. STUDENT SUBMITS</b><ul><li>Student logs complaint via app</li><li>Category, location, details, photo</li><li>Submitted to system</li></ul></div>
          <div class="panel" style="margin-top:10px"><b>2. WARDEN VIEWS and VALIDATES</b><ul><li>Warden receives notification</li><li>Reviews complaint details</li><li>Approves and prioritizes / Assigns to staff</li></ul></div>
          <div class="panel" style="margin-top:10px"><b>3. STAFF RESOLVES</b><ul><li>Staff is assigned task</li><li>Performs repair / action</li><li>Updates resolution status</li></ul></div>
          <div class="panel" style="margin-top:10px;background:#b8d8c8"><b>4. RESOLUTION and FEEDBACK</b><ul><li>Student receives resolution update</li><li>Complaint marked as Closed</li><li>Feedback and Rating recorded</li></ul></div>
        </div>
      </div>
      <div class="goal">✅ Real-Time Notifications &nbsp; ✅ Status Tracking and Audit Log &nbsp; ✅ Secure Role-Based Access</div>
    </div>
  </section>

  <!-- SLIDE 6 TECH -->
  <section class="slide">
    <div class="topbar"><h3>Technologies Used for Hostel Complaint System</h3><span class="badge">Slide 6</span></div>
    <div class="content">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
        <div class="card"><h3>🧡 HTML5 - Structure and Markup</h3><p>Builds the core structure of the complaint form and dashboard</p></div>
        <div class="card"><h3>🛡 CSS3 - Styling and Responsive Design</h3><p>Provides modern, responsive UI with blue theme styling</p></div>
        <div class="card"><h3>🟡 JavaScript - Interactivity and Logic</h3><p>Handles form validation, complaint submission, and dynamic updates</p></div>
        <div class="card"><h3>💾 LocalStorage - Client-Side Data Storage</h3><p>Stores complaints locally in the browser for offline persistence</p></div>
      </div>
      <div class="goal">✅ Lightweight &nbsp; ✅ No Backend Required &nbsp; ✅ Fast and Secure &nbsp; | &nbsp; Built for efficient hostel complaint management</div>
    </div>
  </section>

  <!-- SLIDE 7 STUDENT MODULE -->
  <section class="slide">
    <div class="topbar"><h3>Slide 7 | Student Module for Hostel Complaint System</h3><span>👤 🔔 ❓</span></div>
    <div class="content">
      <div class="two">
        <div class="panel"><h3>🎓 Student Module</h3><ul style="list-style:none;line-height:2.2;font-size:17px"><li>🏠 Dashboard</li><li>📝 <b style="background:#cfe2ff;padding:4px 8px;border-radius:8px">My Complaints</b></li><li>✍️ New Complaint</li><li>📄 Complaint History</li><li>👤 Profile</li><li>⚙️ Settings and Help</li></ul></div>
        <div class="panel">
          <h3>Complaint Form</h3><p>Submit a new complaint or issue for your hostel room</p><br>
          <label>Room Number *</label><input id="room" placeholder="e.g., B-203">
          <label>Category *</label><select id="cat"><option>Select complaint category</option><option>Plumbing</option><option>Electrical</option><option>Cleanliness</option><option>Furniture</option><option>Other</option></select>
          <div class="chips"><span class="chip">💧 Plumbing</span><span class="chip">⚡ Electrical</span><span class="chip">🧹 Cleanliness</span><span class="chip">🪑 Furniture</span><span class="chip">⋯ Other</span></div>
          <label>Description *</label><textarea rows="3" id="desc" placeholder="Describe the issue in detail... e.g., Water leakage from bathroom ceiling"></textarea>
          <label>Attachments (Optional)</label><div style="border:2px dashed #7cb8ff;padding:14px;border-radius:10px;text-align:center">📤 Drag and drop files here or <b>Browse Files</b><br><small>Supported: JPG, PNG, PDF - Max 5MB</small></div><br>
          <div style="display:flex;gap:10px"><button class="btn btn-light" style="flex:1">Cancel</button><button class="btn btn-primary" style="flex:2" onclick="submitComplaint()">✈ Submit Complaint</button></div>
          <p id="msg" style="color:green;font-weight:700;margin-top:10px"></p>
        </div>
      </div>
      <p style="margin-top:14px">💡 Tips: Be clear and detailed to help staff resolve the issue faster</p>
    </div>
  </section>

  <!-- SLIDE 8 WARDEN -->
  <section class="slide">
    <div class="content">
      <h2 style="text-align:left">Warden Admin Panel for Hostel Complaint System</h2>
      <p class="subtitle" style="text-align:left">Complaint Overview and Resolution Dashboard • Updated Oct 2024</p>
      <div style="display:grid;grid-template-columns:200px 1fr;gap:18px;margin-top:16px">
        <div class="panel" style="background:#0a2a6b;color:#fff"><b>🛡 WARDEN PANEL</b><ul style="list-style:none;line-height:2.2;margin-top:10px"><li>🏠 Dashboard</li><li>📋 Complaints</li><li>👥 Students</li><li>🛏 Rooms</li><li>📊 Reports</li><li>⚙️ Settings</li></ul><br><p>👤 Warden Admin<br><small>admin@hostel.edu</small></p></div>
        <div>
          <div class="stats">
            <div class="stat">📋 Total Complaints<br><b>24</b><br><small>All time</small></div>
            <div class="stat">⏰ Pending<br><b style="color:#f59e0b">9</b><br><small>Awaiting resolution</small></div>
            <div class="stat">✅ Solved<br><b style="color:#16a34a">15</b><br><small>Resolved this month</small></div>
          </div>
          <div class="panel" style="margin-top:14px">
            <div style="display:flex;justify-content:space-between"><h3>Complaint List</h3><span>Filter: <b>All Status ▼</b></span></div>
            <table><tr><th>Complaint ID</th><th>Student</th><th>Room</th><th>Complaint</th><th>Date</th><th>Status</th></tr>
            <tr><td>C-1023</td><td>Aarav Sharma</td><td>Room 204</td><td>Leaking tap in bathroom</td><td>07 Oct 2024</td><td><span class="pill pending">Pending ⏰</span></td></tr>
            <tr><td>C-1021</td><td>Priya Mehta</td><td>Room 110</td><td>AC not working</td><td>06 Oct 2024</td><td><span class="pill solved">Solved ✅</span></td></tr>
            <tr><td>C-1019</td><td>Rohan Kumar</td><td>Room 317</td><td>Wi-Fi connectivity issue</td><td>05 Oct 2024</td><td><span class="pill solved">Solved ✅</span></td></tr>
            <tr><td>C-1017</td><td>Neha Singh</td><td>Room 402</td><td>Power outage in room</td><td>04 Oct 2024</td><td><span class="pill pending">Pending ⏰</span></td></tr>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SLIDE 9 CONCLUSION -->
  <section class="slide">
    <div class="topbar"><h3>Slide 9 - Conclusion and Future Scope</h3><span class="badge">Thank You</span></div>
    <div class="content">
      <div class="two">
        <div class="panel"><h3>✅ Conclusion</h3><ul><li>Streamlined the complaint logging and resolution process, improving efficiency and transparency</li><li>Enhanced student satisfaction through faster response and real-time status tracking</li><li>Centralized data management enabling better monitoring and accountability for hostel administration</li><li>Reduced manual paperwork by digitizing the entire complaint workflow</li></ul></div>
        <div class="panel"><h3>🚀 Future Scope</h3><ul><li>Mobile App Integration for easier complaint submission and notifications on the go</li><li>AI-based Complaint Categorization and Priority Analysis for automated routing</li><li>IoT Integration for real-time monitoring of hostel facilities (water, electricity, maintenance)</li><li>Advanced Analytics Dashboard for insights and predictive maintenance trends</li></ul></div>
      </div>
      <div class="thank"><h2>Thank You</h2><p>For your attention -<br>Questions and Feedback are welcome</p></div>
    </div>
  </section>

</div>

<div class="nav">
  <button onclick="change(-1)">← Prev</button>
  <span id="counter">Slide 1 / 9</span>
  <button onclick="change(1)">Next →</button>
</div>

<script>
let idx = 0;
const slides = document.querySelectorAll('.slide');
function show(n){
  idx = (n + slides.length) % slides.length;
  slides.forEach((s,i)=> s.classList.toggle('active', i===idx));
  document.getElementById('counter').textContent = 'Slide ' + (idx+1) + ' / ' + slides.length;
}
function change(d){ show(idx+d); }
function switchRole(r){ alert(r + ' Login Selected'); }
function submitComplaint(){
  const room = document.getElementById('room').value;
  const desc = document.getElementById('desc').value;
  if(!room || !desc){ alert('Please fill Room Number and Description'); return; }
  const data = { room, category: document.getElementById('cat').value, desc, date: new Date().toLocaleDateString() };
  let list = JSON.parse(localStorage.getItem('complaints') || '[]');
  list.push(data);
  localStorage.setItem('complaints', JSON.stringify(list));
  document.getElementById('msg').textContent = 'Complaint Submitted Successfully! ID: C-' + (1000 + list.length);
}
document.addEventListener('keydown', e=>{
  if(e.key==='ArrowRight') change(1);
  if(e.key==='ArrowLeft') change(-1);
});
</script>
</body>
</html>
